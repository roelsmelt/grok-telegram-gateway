#!/usr/bin/env python3
"""Send a Telegram message. Usage: telegram-send <chat|@user|title> <text...>"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from telegram_lib import TelegramError, ensure_state, find_chat, send_message


def main():
    ensure_state()
    if len(sys.argv) < 3:
        print(
            "usage: telegram-send <chat_id|@username|title-fragment> <message>",
            file=sys.stderr,
        )
        return 2
    target = sys.argv[1]
    text = " ".join(sys.argv[2:])
    chat_id = target
    if not target.lstrip("-").isdigit():
        meta = find_chat(target)
        if not meta:
            print(
                f"unknown chat: {target} (need /start or group add first)",
                file=sys.stderr,
            )
            return 1
        chat_id = meta["id"]
    try:
        result = send_message(chat_id, text)
    except TelegramError as e:
        print(f"send failed: {e}", file=sys.stderr)
        return 1
    print(
        f"sent message_id={result.get('message_id')} "
        f"chat_id={result.get('chat', {}).get('id')}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
