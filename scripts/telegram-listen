#!/usr/bin/env python3
"""Long-poll Telegram getUpdates. Safe to leave running."""
import os
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from telegram_lib import (
    LISTEN_PID,
    STATE_DIR,
    TelegramError,
    drain_once,
    ensure_state,
    get_me,
)

STOP = False


def _stop(*_a):
    global STOP
    STOP = True


def main():
    ensure_state()
    LISTEN_PID.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    try:
        me = get_me()
        print(
            f"listening as @{me.get('username')} pid={os.getpid()} state={STATE_DIR}",
            flush=True,
        )
    except TelegramError as e:
        print(f"listen start failed: {e}", file=sys.stderr)
        return 1
    cycles = 0
    while not STOP:
        try:
            stats = drain_once(long_poll=25)
            cycles += 1
            if stats.get("raw_count"):
                print(
                    f"cycle={cycles} updates={stats['raw_count']} "
                    f"handled={stats['handled']} starts={stats['starts']}",
                    flush=True,
                )
        except TelegramError as e:
            print(f"poll error: {e}", flush=True)
            time.sleep(3)
        except Exception as e:
            print(f"unexpected: {type(e).__name__}", flush=True)
            time.sleep(5)
    try:
        if LISTEN_PID.exists() and LISTEN_PID.read_text().strip() == str(os.getpid()):
            LISTEN_PID.unlink()
    except Exception:
        pass
    print("stopped", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
